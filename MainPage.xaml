<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CalculadoraIMC_DISC.MainPage">

    <VerticalStackLayout Padding="20" Spacing="15">

        <Frame BackgroundColor="#422963" Padding="24" CornerRadius="0">
            <Label Text="Calcular IMC" 
                   HorizontalTextAlignment="Center" 
                   TextColor="White" 
                   FontSize="36"/>
        </Frame>

        <Entry Placeholder="Altura" x:Name="Altura" Keyboard="Numeric"/>
        <Entry Placeholder="Peso" x:Name="Peso" Keyboard="Numeric"/>
        <Entry Placeholder="IMC" x:Name="IMC" IsEnabled="False"/>

        <Button Text="Calcular" Clicked="Button_Clicked"/>

    </VerticalStackLayout>

</ContentPage>